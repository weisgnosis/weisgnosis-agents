# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit syntax files
*.scala text eol=lf
*.sbt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.zip binary
